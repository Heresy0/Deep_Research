# Copy to .env.local and supply your own API keys.
DASHSCOPE_API_KEY=
BOCHA_API_KEY=
MODEL=qwen-turbo
HOST=127.0.0.1
PORT=8002
APP_ENV=production
DEEP_RESEARCH_API_TARGET=http://127.0.0.1:8002
ENABLE_MEMORY=true
MAX_ITERATIONS=1
RESEARCH_MAX_CONCURRENCY=2
RESEARCH_MAX_MODEL_CALLS=16
RESEARCH_MAX_WEB_CALLS=12
RESEARCH_MAX_TOOL_CALLS=24
RESEARCH_MAX_SECONDS=180
SHORT_TERM_BACKEND=postgres
LONG_TERM_BACKEND=postgres
CHECKPOINTER_BACKEND=postgres
POSTGRES_DSN=postgresql://deepresearch:deepresearch_local@127.0.0.1:5433/deepresearch
REDIS_URL=redis://127.0.0.1:6380
ENABLE_MILVUS=true
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MILVUS_COLLECTION=deepresearch_memory_local
KNOWLEDGE_COLLECTION=deepresearch_knowledge_local
